    {
      "id": "EP-1",
      "method": "POST",
      "path": "/api/notes",
      "body": [
        "title",
        "body"
      ],
      "status": 201,
      "response": [
        "id",
        "title",
        "body",
        "created_at"
      ]
    },
    {
      "id": "EP-2",
      "method": "GET",
      "path": "/api/notes",
      "status": 200
    },
    {
      "id": "EP-3",
      "method": "DELETE",
      "path": "/api/notes/{id}",
      "status": 204,
      "missing": 404
    },
    {
      "id": "EP-4",
      "method": "POST",
      "path": "/api/notes",
      "invalid": 422
    },
    {
      "id": "EP-5",
      "method": "GET",
      "path": "/api/health",
      "status": 200,
      "fields": [
        "status",
        "spec"
      ]
    }
  ],
